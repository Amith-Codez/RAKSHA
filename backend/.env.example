# Copy to .env (in this folder or the folder above) and fill in ONE provider.
GEMINI_API_KEY=
# More free keys = more free quota. Quota is PER GOOGLE PROJECT, so each key must come from a different
# Google account / project (one per teammate, aistudio.google.com/apikey):
# GEMINI_API_KEY_2=
# GEMINI_API_KEY_3=
# GEMINI_MODEL=gemini-3.8-flash   # optional: tried first; RAKSHA falls back to other Flash models if busy

# Paid backup brain: used automatically (text only) when every Gemini key/model is busy or out of free quota.
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat

# Or use any OpenAI-compatible API as the ONLY provider (OpenAI, Groq, OpenRouter):
# LLM_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# Demo safety: answer only from cached responses (no internet needed for cached ads)
# RAKSHA_OFFLINE=1

# Community memory shared by all families (Supabase). Without these it is saved on this laptop (cache/raksha.db).
# Run supabase/schema.sql once in the Supabase SQL editor first.
# SUPABASE_URL=https://<your-project>.supabase.co
# SUPABASE_SERVICE_KEY=        # service_role key: stays on this server, never in the extension

# Natural voice for "Read aloud" (ElevenLabs). Without it the browser's own voice is used.
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# ELEVENLABS_MODEL=eleven_multilingual_v2

# Speed / safety knobs (defaults are fine)
# SCAN_BUDGET_S=50        # whole-check time budget; after it, agents finish with rule-based checks
# GEMINI_HEDGE_S=0        # e.g. 3.5 with paid keys: ask a second model if the first is slow
# HOST=127.0.0.1          # set 0.0.0.0 only to share the server on a trusted network

# Cloud hosting (render.yaml and the Dockerfile already set these)
# HOST=0.0.0.0
# FORWARDED_ALLOW_IPS=*   # trust the host's proxy so rate limits see each visitor's own IP
# PUBLIC_URL=https://your-app.example.com   # optional: the public address baked into the extension download
